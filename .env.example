# Google Gemini API Key for real-time translation & Rishi AI guide
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Signing Secret (MANDATORY in production; minimum 32 random characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your_secure_random_jwt_secret_min_32_chars_here

# Initial Administrator Bootstrap (Optional: used only during first empty database initialization)
# ADMIN_INIT_USERNAME=admin
# ADMIN_INIT_PASSWORD=your_secure_initial_admin_password_here

# Server Port (Local Dev Mode only - Vercel automatically manages serverless routing)
PORT=5001
